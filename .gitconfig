[user]
	name = James Ross
	email = james@flyingrobots.dev
	signingkey = /Users/j/.ssh/id_ed25519.pub
[init]
	defaultBranch = main
[gpg]
	format = ssh
[commit]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = /Users/j/.ssh/allowed_signers
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	light = false
	line-numbers = true
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
