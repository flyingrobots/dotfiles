# Ghostty Terminal Configuration
font-family = "Monaspace Radon NF"
font-size = 14
theme = tokyonight
mouse-hide-while-typing = true
window-padding-x = 8
window-padding-y = 8

# Aesthetics & macOS integration
macos-titlebar-style = tabs
cursor-style = bar
cursor-style-blink = true
copy-on-select = clipboard
confirm-close-surface = false

# Code Ligatures for Monaspace Radon NF
font-feature = calt
font-feature = liga
font-feature = ss01
font-feature = ss02
font-feature = ss03
font-feature = ss04
font-feature = ss05
font-feature = ss06
font-feature = ss07
font-feature = ss08
font-feature = ss09
font-feature = ss10

# Split navigation
keybind = super+shift+d=new_split:right
keybind = super+d=new_split:down
