# Ghostty Terminal Configuration

# Typography & Font Rendering
font-family = "Monaspace Radon NF"
font-size = 14
font-feature = calt
font-feature = liga
font-feature = ss01
font-feature = ss02
font-feature = ss03
font-feature = ss04
font-feature = ss05
font-feature = ss06
font-feature = ss07
font-feature = ss08
font-feature = ss09
font-feature = ss10

# Theme & Colors
theme = Tomorrow Night Eighties
window-colorspace = display-p3

# Window & Layout
window-padding-x = 8
window-padding-y = 8
window-show-tab-bar = never

# Cursor Styling
cursor-style = bar
cursor-style-blink = false
cursor-color = cell-foreground
cursor-text = cell-background

# Mouse & Surface Behavior
mouse-hide-while-typing = true
copy-on-select = clipboard
confirm-close-surface = false

# macOS Integration
macos-titlebar-style = hidden
macos-window-buttons = hidden
macos-icon = xray
macos-icon-frame = chrome

# Keybindings
keybind = super+shift+d=new_split:right
keybind = super+d=new_split:down
